<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Supply Requisition</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --navy:    #1a2035;
    --navy-mid:#243050;
    --rule:    #dde2ec;
    --text:    #1a2035;
    --muted:   #6b7494;
    --white:   #ffffff;
    --card-bg: #f7f9fc;

    --s1: #ed4d18;
    --s2: #e89d00;
    --s3: #fad82d;
    --s4: #c4da4b;
    --s5: #83c96e;
    --s-cancel: #58595b;
    --inactive: #e2e6ef;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: #eef1f8;
    color: var(--text);
    min-height: 100vh;
    padding: 40px 20px 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page {
    width: 100%;
    max-width: 760px;
  }

  /* ── Header ── */
  .doc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  .doc-header .agency {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .doc-header .doc-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--navy);
  }
  .doc-header .doc-id {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    text-align: right;
  }

  /* ── Card ── */
  .card {
    background: var(--white);
    border-radius: 14px;
    box-shadow: 0 2px 16px rgba(26,32,53,.08);
    overflow: hidden;
    margin-bottom: 20px;
  }
  .card-header {
    background: var(--navy);
    color: var(--white);
    padding: 18px 28px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .card-header .icon {
    width: 36px; height: 36px;
    background: rgba(255,255,255,.12);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
  }
  .card-header h2 {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: .03em;
  }
  .card-body {
    padding: 24px 28px;
  }

  /* ── Field grid ── */
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .field {
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .field:nth-last-child(-n+2) { border-bottom: none; }
  .field.full { grid-column: 1 / -1; }
  .field-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .field-value {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    min-height: 20px;
  }
  .field-value.mono {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
  }

  /* ── Status bar ── */
  .status-section {
    padding: 20px 28px 24px;
    border-top: 1px solid var(--rule);
  }
  .status-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .status-bar {
    display: flex;
    gap: 4px;
    margin-bottom: 6px;
  }
  .status-seg {
    flex: 1;
    height: 14px;
    border-radius: 3px;
    background: var(--inactive);
    transition: background .3s;
  }
  .status-names {
    display: flex;
    gap: 4px;
  }
  .status-name {
    flex: 1;
    font-size: 10px;
    text-align: center;
    color: var(--muted);
    font-weight: 500;
  }
  .status-name.active { color: var(--text); font-weight: 600; }

  /* ── Items table ── */
  .items-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .items-table thead tr {
    background: var(--card-bg);
    border-bottom: 2px solid var(--rule);
  }
  .items-table th {
    padding: 10px 12px;
    text-align: left;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .items-table th.center { text-align: center; }
  .items-table tbody tr { border-bottom: 1px solid var(--rule); }
  .items-table tbody tr:last-child { border-bottom: none; }
  .items-table td {
    padding: 11px 12px;
    color: var(--text);
    font-weight: 400;
  }
  .items-table td.center { text-align: center; }
  .items-table td.mono {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
  }
  .check-cell {
    width: 36px;
    text-align: center;
  }
  .check-box {
    width: 16px; height: 16px;
    border: 2px solid var(--rule);
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--white);
    font-size: 11px;
    color: #83c96e;
    font-weight: 700;
  }
  .check-box.filled {
    background: #f0fbee;
    border-color: #83c96e;
  }

  /* ── Notes ── */
  .notes-box {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 14px 16px;
    font-size: 14px;
    color: var(--text);
    line-height: 1.6;
    min-height: 60px;
  }

  /* ── Print button ── */
  .print-bar {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: var(--white);
    border-top: 1px solid var(--rule);
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    z-index: 100;
    box-shadow: 0 -4px 20px rgba(26,32,53,.07);
  }
  .btn-print {
    background: var(--navy);
    color: var(--white);
    border: none;
    border-radius: 8px;
    padding: 11px 32px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: .02em;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background .2s, transform .1s;
  }
  .btn-print:hover { background: #243050; }
  .btn-print:active { transform: scale(.97); }
  .print-hint {
    font-size: 12px;
    color: var(--muted);
  }

  /* ── Empty state ── */
  .empty { color: var(--muted); font-style: italic; }

  /* ── Print styles ── */
  @media print {
    body { background: white; padding: 0; }
    .print-bar { display: none; }
    .card { box-shadow: none; border: 1px solid #dde2ec; border-radius: 8px; }
    .page { max-width: 100%; }
  }
</style>
</head>
<body>
<div class="page">

  <div class="doc-header">
    <div>
      <div class="agency">Supply Requisition</div>
      <div class="doc-title">Request Summary</div>
    </div>
    <div class="doc-id" id="doc-id-block"></div>
  </div>

  <!-- Main info card -->
  <div class="card">
    <div class="card-header">
      <div class="icon">📋</div>
      <h2>Request Details</h2>
    </div>
    <div class="card-body">
      <div class="fields">
        <div class="field">
          <div class="field-label">Date</div>
          <div class="field-value" id="f-date">—</div>
        </div>
        <div class="field">
          <div class="field-label">Staff</div>
          <div class="field-value" id="f-staff">—</div>
        </div>
        <div class="field">
          <div class="field-label">Station</div>
          <div class="field-value" id="f-station">—</div>
        </div>
        <div class="field">
          <div class="field-label">Shift</div>
          <div class="field-value" id="f-shift">—</div>
        </div>
        <div class="field full">
          <div class="field-label">Officer</div>
          <div class="field-value" id="f-officer">—</div>
        </div>
      </div>
    </div>

    <!-- Status bar -->
    <div class="status-section">
      <div class="status-label">Status</div>
      <div class="status-bar">
        <div class="status-seg" id="seg1"></div>
        <div class="status-seg" id="seg2"></div>
        <div class="status-seg" id="seg3"></div>
        <div class="status-seg" id="seg4"></div>
        <div class="status-seg" id="seg5"></div>
      </div>
      <div class="status-names">
        <div class="status-name" id="sn1">Submitted</div>
        <div class="status-name" id="sn2">Received</div>
        <div class="status-name" id="sn3">Ordered</div>
        <div class="status-name" id="sn4">Partially Filled</div>
        <div class="status-name" id="sn5">Completed</div>
      </div>
    </div>
  </div>

  <!-- Justification & Notes -->
  <div class="card">
    <div class="card-header">
      <div class="icon">📝</div>
      <h2>Justification &amp; Notes</h2>
    </div>
    <div class="card-body">
      <div class="fields">
        <div class="field full">
          <div class="field-label">Justification</div>
          <div class="notes-box" id="f-justification"></div>
        </div>
        <div class="field full" style="border-bottom:none; padding-top:16px;">
          <div class="field-label">Admin Notes</div>
          <div class="notes-box" id="f-notes"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Items Requested -->
  <div class="card">
    <div class="card-header">
      <div class="icon">📦</div>
      <h2>Items Requested</h2>
    </div>
    <div class="card-body" style="padding: 0;">
      <table class="items-table">
        <thead>
          <tr>
            <th class="center check-cell">Filled</th>
            <th>Description</th>
            <th class="center">Qty</th>
            <th>Size</th>
            <th>Unit</th>
          </tr>
        </thead>
        <tbody id="items-tbody">
          <tr><td colspan="5" class="empty" style="padding:20px 12px;">No items found.</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</div><!-- /page -->

<!-- Print bar -->
<div class="print-bar">
  <span class="print-hint">Ready to print or save as PDF</span>
  <button class="btn-print" onclick="window.print()">
    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9V2h12v7"/><rect x="6" y="14" width="12" height="8" rx="1"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/></svg>
    Print / Save PDF
  </button>
</div>

<script>
  const p = new URLSearchParams(window.location.search);

  function get(key, fallback) {
    const v = p.get(key);
    return (v && v.trim() && v !== 'null' && v !== 'undefined') ? decodeURIComponent(v) : (fallback || '—');
  }

  // Main fields
  document.getElementById('f-date').textContent      = get('date');
  document.getElementById('f-staff').textContent     = get('staff');
  document.getElementById('f-station').textContent   = get('station');
  document.getElementById('f-shift').textContent     = get('shift');
  document.getElementById('f-officer').textContent   = get('officer');
  document.getElementById('f-justification').textContent = get('justification', '');
  document.getElementById('f-notes').textContent     = get('notes', '');

  // Doc ID block
  const dateStr = get('date') !== '—' ? get('date') : '';
  const station = get('station') !== '—' ? get('station') : '';
  document.getElementById('doc-id-block').innerHTML =
    (station ? `<div>${station}</div>` : '') +
    (dateStr ? `<div>${dateStr}</div>` : '');

  // Status bar
  const statusMap = {
    'Submitted':       { segs: [1], color: '#ed4d18' },
    'Received':        { segs: [1,2], color: '#e89d00' },
    'Ordered':         { segs: [1,2,3], color: '#fad82d' },
    'Partially Filled':{ segs: [1,2,3,4], color: '#c4da4b' },
    'Completed':       { segs: [1,2,3,4,5], color: '#83c96e' },
    'Cancelled':       { segs: [1,2,3,4,5], color: '#58595b' }
  };
  const colors = ['#ed4d18','#e89d00','#fad82d','#c4da4b','#83c96e'];
  const status = get('status', '');
  const statusConf = statusMap[status];
  if (statusConf) {
    statusConf.segs.forEach((n, i) => {
      const seg = document.getElementById('seg' + n);
      if (seg) seg.style.background = (status === 'Cancelled') ? '#58595b' : colors[i];
    });
    // Label the last segment if cancelled
    if (status === 'Cancelled') document.getElementById('sn5').textContent = 'Cancelled';
    // Bold active label
    const activeIdx = statusConf.segs[statusConf.segs.length - 1];
    const sn = document.getElementById('sn' + activeIdx);
    if (sn) sn.classList.add('active');
  }

  // Items table
  // Expected URL param: items=JSON array of {filled,description,quantity,size,unit}
  // Each record is pipe-delimited: filled|description|quantity|size|unit
  // Multiple records are semicolon-delimited
  const rawItems = p.get('items');
  const tbody = document.getElementById('items-tbody');

  if (rawItems && rawItems.trim()) {
    try {
      const records = rawItems.split(';').map(r => {
        const parts = r.split('|');
        return {
          filled:      parts[0] || '',
          description: parts[1] || '',
          quantity:    parts[2] || '',
          size:        parts[3] || '',
          unit:        parts[4] || ''
        };
      }).filter(r => r.description || r.quantity);

      if (records.length > 0) {
        tbody.innerHTML = records.map(item => {
          const isFilled = item.filled && item.filled.toLowerCase() === 'yes';
          return `
            <tr>
              <td class="center check-cell">
                <div class="check-box${isFilled ? ' filled' : ''}">${isFilled ? '✓' : ''}</div>
              </td>
              <td>${item.description || '<span class="empty">—</span>'}</td>
              <td class="center mono">${item.quantity || '—'}</td>
              <td>${item.size || '—'}</td>
              <td>${item.unit || '—'}</td>
            </tr>`;
        }).join('');
      }
    } catch(e) {
      console.warn('Could not parse items', e);
    }
  }
</script>
</body>
</html>
